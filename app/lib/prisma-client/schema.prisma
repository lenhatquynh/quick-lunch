generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output        = "../app/lib/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Menu {
  id          String     @id @default(cuid())
  date        DateTime   @db.Date
  creatorName String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  isLocked    Boolean    @default(false)
  items       MenuItem[]

  @@index([date])
}

model MenuItem {
  id          String      @id @default(cuid())
  menuId      String
  name        String
  notes       String?
  /// Số lượng tối đa được chọn. null = không giới hạn
  maxQuantity Int?
  /// Món đã bị gỡ khỏi menu nhưng vẫn giữ lựa chọn của người dùng
  isArchived  Boolean     @default(false)
  sortOrder   Int         @default(autoincrement())
  menu        Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  selections  Selection[]

  @@index([menuId, isArchived])
}

model Selection {
  id         String    @id @default(cuid())
  menuItemId String
  personName String
  /// Ghi chú riêng của người chọn cho món này (VD: cơm ít, nhiều cơm)
  note       String?
  isPaid     Boolean   @default(false)
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@index([personName])
  @@index([isPaid])
}
